{
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      }
    ],
    "routes": [
      { "src": "/assets/(.*)", "headers": { "cache-control": "public,max-age=31536000,immutable" } },
      { "src": "/assets/clients/(.*)", "headers": { "cache-control": "public,max-age=31536000,immutable" } },
      { "src": "/(.*)", "dest": "/index.html" }
    ]
  }
  